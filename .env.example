# Copy to .env and fill in. Nothing here is required for the app to start —
# each feature reports itself as unconfigured until its value is set.

# --- Jellyfin (identity provider + library) ---------------------------------
# The bridge only issues sessions to these origins. Comma-separated.
ALLOWED_SERVERS=http://jellyfin.local:8096
# Prefilled in the sign-in form.
DEFAULT_JELLYFIN_URL=http://jellyfin.local:8096

# --- Aura on the TV ---------------------------------------------------------
# Mirror link address: <tv-ip>:8099 (Aura serves this while it is in the
# foreground). Required for the queue, transport and screen mirroring.
AURA_LINK=

# --- Optional extras --------------------------------------------------------
# ADB serial for launching Aura when it is not running, e.g. 192.168.1.50:5555.
# Leave empty to run without ADB; everything except auto-launch still works.
ADB_SERIAL=

# Cast targets to probe directly when the bridge cannot see mDNS multicast
# (bridged Docker on a filtered network). Comma-separated hosts.
STATIC_TARGETS=

# --- Bridge -----------------------------------------------------------------
# Host port the UI/API is published on.
BRIDGE_PORT=8100
